# ===== 必填：DeepSeek API Key =====
DEEPSEEK_API_KEY=sk-xxx

# ===== 可选环境变量 =====

# 强制指定项目根目录（默认按代码位置自动推导，一般无需设置）
# RED_ARCHIVE_PROJECT_DIR=C:\path\to\Red-Aechives-Agent

# 原始 PDF 档案目录（build_pipeline.py 提取 PDF 时使用）
# RED_ARCHIVE_PDF_DIR=C:\path\to\云南省红军长征档案文献

# 档案篇目目录 xlsx 路径（toc_index.py 首次解析时使用；
# 解析结果缓存到 data/knowledge_graph/book_toc.json，之后无需 xlsx 即可重建索引）
# RED_ARCHIVE_TOC_XLSX=C:\path\to\红军长征过云南相关档案文献目录.xlsx

# 知识图谱 JSON 路径（默认 data/knowledge_graph/knowledge_graph.json）
# ARCHIVE_KNOWLEDGE_GRAPH_PATH=C:\path\to\knowledge_graph.json
