# ===== 必填：DeepSeek API Key =====
DEEPSEEK_API_KEY=sk-xxx

# DeepSeek 模型配置
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web 服务
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=0

# ===== 网站真实登录：PostgreSQL + JWT =====
# 未配置时回退到本地 JSON 登录，仅用于开发演示
RED_ARCHIVE_DATABASE_URL=postgresql+psycopg://red_agent:red_agent_dev_password@127.0.0.1:5432/red_archives
RED_ARCHIVE_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_SECRET_KEY=please-change-me-to-a-long-random-jwt-secret
JWT_EXPIRE_HOURS=168

# ===== 可选环境变量 =====

# 强制指定项目根目录（默认按代码位置自动推导，一般无需设置）
# RED_ARCHIVE_PROJECT_DIR=C:\path\to\Red-Aechives-Agent

# 原始 OCR PDF 档案目录（证据链原 PDF 页面溯源 / build_pipeline.py 提取 PDF 时使用）
# RED_ARCHIVE_PDF_DIR=C:\path\to\云南省红军长征档案文献

# 档案篇目目录 xlsx 路径（toc_index.py 首次解析时使用；
# 解析结果缓存到 data/knowledge_graph/book_toc.json，之后无需 xlsx 即可重建索引）
# RED_ARCHIVE_TOC_XLSX=C:\path\to\红军长征过云南相关档案文献目录.xlsx

# 知识图谱 JSON 路径（默认 data/knowledge_graph/knowledge_graph.json）
# ARCHIVE_KNOWLEDGE_GRAPH_PATH=C:\path\to\knowledge_graph.json
