# 统一文本文件换行符与编码，避免 Windows(CRLF) 与 macOS/Linux(LF) 合并冲突
* text=auto

# Python / 脚本 / 文档：强制 LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pkl binary
*.npz binary
